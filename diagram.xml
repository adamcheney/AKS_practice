<mxfile host="app.diagrams.net">
  <diagram name="Bootstrap Flow">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start / make target" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- New PS session -->
        <mxCell id="ps" value="New PowerShell session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s-ps" edge="1" parent="1" source="start" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- initialise.ps1 -->
        <mxCell id="init" value="initialise.ps1&#xa;• Ensure PSResourceGet v3&#xa;• Install + import Azure modules"
                style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-init" edge="1" parent="1" source="ps" target="init">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- AzureBootstrap -->
        <mxCell id="boot" value="Module: AzureBootstrap&#xa;• Read config&#xa;• Login&#xa;• Create RG&#xa;• Load providers"
                style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s-boot" edge="1" parent="1" source="init" target="boot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- AzureIdentity -->
        <mxCell id="identity" value="Module: AzureIdentity&#xa;• Create KV&#xa;• App/SP&#xa;• Certs&#xa;• AppCredential&#xa;• Upload PFX"
                style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s-ident" edge="1" parent="1" source="boot" target="identity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- AzureStorage -->
        <mxCell id="storage" value="Module: AzureStorage&#xa;• Create Storage Account"
                style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-store" edge="1" parent="1" source="identity" target="storage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Problem branch -->
        <mxCell id="problem" value="Issue: each make target starts a new PS session →\nno previously imported modules or config"
                style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#cc0000;fillColor=#ffe6e6;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ps-problem" edge="1" parent="1" source="ps" target="problem" style="dashed=1;strokeColor=#cc0000;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
